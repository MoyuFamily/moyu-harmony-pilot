<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>org.example.harmony-pilot</string>
    <key>ProgramArguments</key>
    <array>
        <string>/ABSOLUTE/PATH/moyu-harmony-pilot/.venv/bin/harmony-pilot</string>
        <string>serve</string>
        <string>--config</string>
        <string>/ABSOLUTE/PATH/moyu-harmony-pilot/bridge.local.json</string>
        <string>--json</string>
    </array>
    <key>WorkingDirectory</key><string>/ABSOLUTE/PATH/moyu-harmony-pilot</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>30</integer>
    <key>ExitTimeOut</key><integer>90</integer>
    <key>Umask</key><integer>63</integer>
    <key>StandardOutPath</key><string>/ABSOLUTE/PATH/moyu-harmony-pilot/.state/bridge.stdout.log</string>
    <key>StandardErrorPath</key><string>/ABSOLUTE/PATH/moyu-harmony-pilot/.state/bridge.stderr.log</string>
</dict>
</plist>
