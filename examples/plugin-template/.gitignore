devices.local.json
devices.local.yml
bridge.local.*
bridge-token.local

# Environments
.env
.env.*
!.env.example
venv/
.venv/
ENV/

# Distribution / packaging / testing
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
